# Match the primary appearance and window behavior of the WezTerm setup.
theme = "TokyoNight Moon"

font-family = "MesloLGS Nerd Font Mono"
font-size = 16

window-decoration = true
macos-titlebar-style = hidden
window-padding-x = 12
window-padding-y = 12
background-opacity = 0.95
background-opacity-cells = true
background-blur = 1

window-width = 90
window-height = 30
