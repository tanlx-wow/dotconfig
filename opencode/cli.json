{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight",
    "mode": "system"
  },
  "animations": true,
  "mouse": true,
  "scroll": {
    "speed": 3,
    "acceleration": false
  },
  "prompt": {
    "editor": true,
    "paste": "compact",
    "image_preview": false
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "submit_scroll": "bottom",
    "thinking": "hide",
    "grouping": "auto",
    "image_preview": false,
    "tps": true,
    "markdown": "rendered",
    "new_location": "launch",
    "permissions": "prompt"
  },
  "tabs": {
    "mode": "on",
    "scope": "global",
    "layout": "vertical",
    "indicators": "numbers"
  },
  "diffs": {
    "source": "branch",
    "wrap": "word",
    "tree": true,
    "single": false,
    "view": "auto"
  },
  "attention": {
    "notifications": true,
    "sound": false
  },
  "terminal": {
    "title": true,
    "copy": "select"
  }
}
