{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@slkiser/opencode-quota"],
  "provider": {
    "openai": {
      "options": {
        "headerTimeout": 60000,
        "timeout": 600000,
        "chunkTimeout": 60000
      }
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "rm": "deny",
      "rm *": "deny",
      "rmdir": "deny",
      "rmdir *": "deny",
      "unlink": "deny",
      "unlink *": "deny",
      "sudo": "deny",
      "sudo *": "deny",
      "git clean": "deny",
      "git clean *": "deny",
      "git reset --hard": "deny",
      "git reset --hard *": "deny",
      "git push": "deny",
      "git push *": "deny"
    },
    "edit": "ask",
    "external_directory": "deny"
  }
}
