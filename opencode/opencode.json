{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["@slkiser/opencode-quota"],
  "providers": {
    "openai": {
      "settings": {
        "headerTimeout": 60000,
        "timeout": 600000,
        "chunkTimeout": 60000
      }
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "policies": [
    {
      "action": "tool.use",
      "resource": "shell:rm *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:rmdir *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:unlink *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:sudo *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git clean *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git reset --hard *",
      "effect": "deny"
    },
    {
      "action": "tool.use",
      "resource": "shell:git push *",
      "effect": "deny"
    }
  ]
}
