{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "padding": {
      "top": 1,
      "right": 4
    }
  },
  "display": {
    "separator": "",
    "key": {
      "width": 12
    },
    "brightColor": false
  },
  "modules": [
    {
      "type": "custom",
      "format": "┌──────────────────── Hardware ────────────────────┐"
    },
    {
      "type": "cpu",
      "key": "│  CPU",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "│ 󰢮 GPU",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "│  RAM",
      "keyColor": "green",
      "format": "{used} / {total} ({#green}{percentage}{#})"
    },
    {
      "type": "disk",
      "key": "│  Disk",
      "keyColor": "green",
      "folders": "/",
      "format": "{size-used} / {size-total} ({#green}{size-percentage}{#}) - {filesystem}"
    },
    {
      "type": "custom",
      "format": "└─────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "┌──────────────────── Software ────────────────────┐"
    },
    {
      "type": "os",
      "key": "│  OS",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "│  Kernel",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "│ 󰏖 PKGs",
      "keyColor": "yellow",
      "format": "{nix-all} (nix)"
    },
    {
      "type": "packages",
      "key": "│",
      "keyColor": "yellow",
      "format": "{brew-all} (brew)"
    },
    {
      "type": "shell",
      "key": "│  Shell",
      "keyColor": "yellow"
    },
    {
      "type": "terminal",
      "key": "│  Term",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "└─────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "┌───────────────────── Uptime ─────────────────────┐"
    },
    {
      "type": "uptime",
      "key": "│  Uptime",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "└─────────────────────────────────────────────────┘"
    }
  ]
}
